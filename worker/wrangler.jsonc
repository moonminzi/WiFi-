/**
 * QR 파일 공유용 Worker.
 * 파일은 Workers KV에 조각(최대 20MB)으로 나눠 저장되고, 만료 시간이 지나면 KV가 자동으로 지운다.
 * 업로드 비밀번호는 대시보드 Settings → Variables and Secrets에서 UPLOAD_TOKEN 시크릿으로 넣는다.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "qr-share",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "FILES",
			"id": "ee10e71e4b7c49b3a8309a97cec75c4c"
		}
	]
}
