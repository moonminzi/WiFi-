<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- neptun: 와이파이↔모바일 데이터 전환을 따라가려고 기본 망 콜백을 건다(없으면 SecurityException으로 앱이 죽음) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Nago">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 앱 안 WireGuard의 NepTUN 엔진(NeptunVpnService). go 엔진은 wireguard-android 라이브러리의 서비스를 쓴다 -->
        <service
            android:name=".NeptunVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 시스템 VPN(IKEv2)이 연결 실패/해제 이유를 알려 주는 이벤트 -->
        <receiver
            android:name=".VpnEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.action.VPN_MANAGER_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
